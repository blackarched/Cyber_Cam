# .env.example

# --- CORE SERVER CONFIGURATION ---
# The secure port for the main HTTPS API server
PORT=8443
# The port for the WebSocket surveillance grid
WS_PORT=8080
# The origin URL for the frontend dashboard to enforce CORS
FRONTEND_ORIGIN=https://localhost:8443
# Application environment (development, production)
NODE_ENV=development

# --- DATABASE (POSTGRES) ---
DB_HOST=nexus-postgres
DB_PORT=5432
DB_USER=nexus_admin
DB_NAME=nexus_security
# Use a strong, randomly generated password in production
DB_PASSWORD=quantum_secure_2024

# --- CACHE (REDIS) ---
REDIS_HOST=nexus-redis
REDIS_PORT=6379
# Use a strong, randomly generated password in production
REDIS_PASSWORD=nexus_cache_key

# --- SECURITY & AUTHENTICATION ---
# Use a long, complex, randomly generated string for the JWT secret
JWT_SECRET=nexus-quantum-key-2024-replace-this-with-a-real-secret
# SSL Certificate paths within the container
SSL_CERT_PATH=/app/certs/cert.pem
SSL_KEY_PATH=/app/certs/key.pem

# --- EXTERNAL BINARIES ---
# Path to FFmpeg executable if not in system PATH
FFMPEG_PATH=/usr/bin/ffmpeg